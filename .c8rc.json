{
  "reporter": ["text", "lcov", "text-summary"],
  "include": [
    "handlers/**/*.js",
    "core/**/*.js",
    "engines/**/*.js",
    "brain/**/*.js",
    "orchestrator/**/*.js"
  ],
  "exclude": [
    "node_modules/**",
    "test/**",
    "tests/**",
    "team/**",
    "docs/**",
    "bin/**",
    "scripts/**",
    "**/*.test.js"
  ],
  "check-coverage": true,
  "lines": 25,
  "statements": 25,
  "functions": 40,
  "branches": 60,
  "watermarks": {
    "lines": [25, 70],
    "functions": [40, 70],
    "branches": [60, 85],
    "statements": [25, 70]
  }
}
