# ===== AI Provider 配置 =====
# 可选值: openai, deepseek, qwen
AI_PROVIDER=openai

# AI API Key
AI_API_KEY=your-api-key-here

# 可选配置
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_MAX_TOKENS=2000
# AI_TEMPERATURE=0.3

# ===== MCP 服务配置 =====
# 运行模式: stdio (默认，用于 IDE 集成) | http (HTTP SSE 模式，用于远程调用)
# MCP_MODE=stdio

# HTTP 模式监听端口（仅 MCP_MODE=http 时生效，默认 3456）
# MCP_HTTP_PORT=3456

# HTTP 模式 API Key 认证（强烈建议生产环境设置）
# 未设置时 HTTP 服务器无认证保护，仅适合本地开发
# 客户端通过 Authorization: Bearer <MCP_API_KEY> 头传递
# MCP_API_KEY=your-secret-api-key-here

# ===== 浏览器与安全配置 =====
# 无头模式: true (默认) | false | 0 | no
# VALIDPILOT_HEADLESS=true

# 敏感数据脱敏: true (默认) | false | 0 | no
# 关闭后 console/network/cookie 中的密钥、令牌将原样输出，存在泄露风险
# VALIDPILOT_REDACTION=true

# 产物存储目录（截图、HAR、报告等，默认为项目根目录下 artifacts/）
# VALIDPILOT_ARTIFACT_DIR=/path/to/artifacts

# 允许访问的主机白名单（逗号分隔，默认 localhost,127.0.0.1,::1）
# 仅白名单内主机可被浏览器工具访问，防止 SSRF
# VALIDPILOT_ALLOWLIST=localhost,127.0.0.1,::1

# 禁止访问的主机黑名单（逗号分隔，默认为空）
# 优先级高于白名单：即使主机在白名单中，命中黑名单也会被拒绝
# VALIDPILOT_BLOCKED_HOSTS=evil.com,bad.net

# ===== 后端日志采集 =====
# 后端日志文件绝对路径（用于 evidence_pack 等工具采集后端日志证据）
# 不设置时将自动探测常见路径（/var/log/app.log, ./logs/app.log 等）
# BACKEND_LOG_PATH=/var/log/your-app/app.log
