{
  "name": "atl_fix",
  "description": "基于ATL似然比学习结果执行自动修复，支持代码修改、配置调整、数据库迁移等非纯文本修复操作。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "patternId": { "type": "string", "description": "要应用的修复模式ID" },
      "fixType": { "type": "string", "enum": ["code", "config", "database", "command"], "description": "修复类型" },
      "targetFile": { "type": "string", "description": "目标文件路径" },
      "replacePattern": { "type": "string", "description": "要替换的代码模式" },
      "replaceWith": { "type": "string", "description": "替换后的代码" },
      "sqlStatement": { "type": "string", "description": "要执行的SQL语句" },
      "command": { "type": "string", "description": "要执行的命令" },
      "configKey": { "type": "string", "description": "配置键" },
      "configValue": { "type": ["string", "number", "boolean"], "description": "配置值" },
      "dryRun": { "type": "boolean", "description": "是否仅预览不执行，默认false" },
      "backup": { "type": "boolean", "description": "是否备份原始文件，默认true" }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean", "description": "修复是否成功" },
      "dryRun": { "type": "boolean", "description": "是否为预览模式" },
      "fixType": { "type": "string", "description": "修复类型" },
      "patternId": { "type": "string", "description": "应用的修复模式ID" },
      "changes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["file_modified", "file_created", "file_backup", "sql_executed", "command_executed", "config_changed"] },
            "path": { "type": "string", "description": "文件路径或命令" },
            "oldContent": { "type": "string", "description": "修改前的内容（截断）" },
            "newContent": { "type": "string", "description": "修改后的内容（截断）" },
            "backupPath": { "type": "string", "description": "备份文件路径" }
          }
        }
      },
      "message": { "type": "string", "description": "执行结果消息" },
      "nextSteps": { "type": "array", "items": { "type": "string" }, "description": "验证修复的下一步建议" }
    },
    "required": ["success", "fixType", "changes"]
  }
}