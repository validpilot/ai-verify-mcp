{
  "name": "atl_learn",
  "description": "基于历史修复模式库的ATL似然比学习机制，分析当前错误与历史修复案例的匹配度，计算贝叶斯后验概率，推荐最可能的根因和修复方案。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "errorText": { "type": "string", "description": "错误文本或消息" },
      "errorUrl": { "type": "string", "description": "错误发生的URL" },
      "errorType": { "type": "string", "description": "错误类型（console/network/pageerror）" },
      "errorStatus": { "type": "number", "description": "HTTP状态码（网络错误时）" },
      "focus": { "type": "string", "description": "聚焦的错误关键词" },
      "currentOnly": { "type": "boolean", "description": "是否只分析当前checkpoint之后的错误，默认true" },
      "includeWarnings": { "type": "boolean", "description": "是否包含警告级别的错误，默认false" }
    }
  }
}