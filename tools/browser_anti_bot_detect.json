{
  "name": "browser_anti_bot_detect",
  "description": "检测页面反爬机制（Cloudflare/JS Challenge/验证码/CAPTCHA等），提供绕过建议和缓解方案。支持检测主流反爬服务并给出风险评估。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "要检测的目标 URL。如果不提供则使用当前页面。"
      },
      "checkHeaders": {
        "type": "boolean",
        "default": true,
        "description": "是否检查响应头中的反爬信号"
      },
      "checkJsChallenges": {
        "type": "boolean",
        "default": true,
        "description": "是否检测 JS Challenge"
      },
      "checkCaptcha": {
        "type": "boolean",
        "default": true,
        "description": "是否检测验证码"
      },
      "checkFingerprint": {
        "type": "boolean",
        "default": true,
        "description": "是否检测浏览器指纹"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "detected": {
        "type": "object"
      },
      "riskLevel": {
        "type": "string"
      },
      "recommendations": {
        "type": "array"
      }
    }
  }
}
