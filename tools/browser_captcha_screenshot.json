{
  "name": "browser_captcha_screenshot",
  "description": "精准截取验证码图片区域，保存为PNG文件。支持自动检测验证码位置或手动指定选择器。截图文件可用于后续OCR分析或人工识别。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "目标页面URL，可选" },
      "captchaSelector": { "type": "string", "description": "验证码图片的CSS选择器，可选（如果不提供则自动检测）" },
      "padding": { "type": "number", "description": "截图边界padding，默认4px", "default": 4 },
      "savePath": { "type": "string", "description": "自定义保存路径，可选" },
      "autoRefresh": { "type": "boolean", "description": "如果截图尺寸过小，是否自动刷新验证码并重试", "default": true },
      "minSize": { "type": "number", "description": "最小截图尺寸（像素），低于此值认为截图失败", "default": 100 }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "image": { "type": "string", "description": "截图文件路径" },
      "captchaUrl": { "type": "string", "description": "验证码图片URL" },
      "elementSize": {
        "type": "object",
        "properties": {
          "width": { "type": "number" },
          "height": { "type": "number" }
        }
      },
      "screenshotSize": {
        "type": "object",
        "properties": {
          "width": { "type": "number" },
          "height": { "type": "number" }
        }
      },
      "padding": { "type": "number", "description": "实际使用的padding值" },
      "selector": { "type": "string", "description": "使用的元素选择器" },
      "refreshed": { "type": "boolean", "description": "是否自动刷新过验证码" },
      "hash": { "type": "string", "description": "截图文件MD5哈希值，用于校验截图一致性" },
      "fileSize": { "type": "number", "description": "截图文件大小（字节）" },
      "nextSteps": {
        "type": "array",
        "items": { "type": "string" },
        "description": "下一步建议操作"
      },
      "tips": { "type": "string", "description": "使用提示" }
    }
  }
}