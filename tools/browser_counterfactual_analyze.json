{
  "name": "browser_counterfactual_analyze",
  "description": "反事实根因分析 - 当测试失败时，分析\"如果消除因素X（遮挡物/JS错误/HTTP错误/加载问题），测试是否还会失败\"，自动生成根因假设并按置信度排序，给出验证工具建议",
  "inputSchema": {
    "type": "object",
    "properties": {
      "failureContext": {
        "type": "string",
        "description": "可选，失败上下文描述（如\"按钮不可见\"、\"表单提交失败\"、\"网络超时\"等），用于匹配相关根因假设并提高置信度"
      },
      "format": {
        "type": "string",
        "enum": ["json", "html"],
        "default": "json",
        "description": "输出格式：json（默认结构化数据）或 html（HTML 报告）"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string", "enum": ["success", "warning"] },
      "failureContext": { "type": "string" },
      "pageState": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "loadingState": { "type": "string" },
          "loadTime": { "type": "number" },
          "jsErrorCount": { "type": "number" },
          "httpErrorCount": { "type": "number" },
          "overlayCount": { "type": "number" },
          "hasBlockingOverlay": { "type": "boolean" },
          "interactiveElements": { "type": "number" }
        }
      },
      "hypotheses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "factor": { "type": "string" },
            "description": { "type": "string" },
            "counterfactual": { "type": "string" },
            "wouldStillFail": { "type": "string", "enum": ["likely", "maybe", "unlikely"] },
            "confidence": { "type": "number" },
            "contextMatch": { "type": "boolean" },
            "impact": { "type": "string", "enum": ["high", "medium", "low"] },
            "evidence": { "type": "array" },
            "verifyTool": { "type": "string" },
            "verifyAction": { "type": "string" }
          }
        }
      },
      "rootCause": {
        "type": "object",
        "properties": {
          "factor": { "type": "string" },
          "confidence": { "type": "number" },
          "verifyTool": { "type": "string" },
          "verifyAction": { "type": "string" }
        }
      },
      "hasHighConfidenceRootCause": { "type": "boolean" },
      "nextSteps": { "type": "array", "items": { "type": "string" } },
      "suggestions": { "type": "array", "items": { "type": "object" } },
      "paidUpgradeHint": { "type": "string" }
    }
  }
}
