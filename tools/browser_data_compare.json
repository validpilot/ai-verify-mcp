{
  "name": "browser_data_compare",
  "description": "数据一致性比对：提取页面表格、卡片、列表数据，与期望数据或基准数据进行比对，识别数据缺失、格式错误、内容差异。支持多种数据源：DOM表格、JSON响应、localStorage、API返回数据。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "session": { "type": "number", "description": "浏览器会话ID" },
      "compareMode": {
        "type": "string",
        "enum": ["dom_vs_api", "dom_vs_storage", "dom_vs_expected", "api_vs_storage", "api_vs_expected", "storage_vs_expected", "baseline_compare"],
        "description": "比对模式：dom_vs_api=页面数据与API响应比对，dom_vs_storage=页面数据与本地存储比对，dom_vs_expected=页面数据与期望数据比对，baseline_compare=与已保存的基线比对",
        "default": "dom_vs_api"
      },
      "selector": { "type": "string", "description": "目标数据区域的CSS选择器，如表格、卡片列表容器" },
      "apiEndpoint": { "type": "string", "description": "API端点URL，用于获取比对数据" },
      "apiMethod": { "type": "string", "enum": ["GET", "POST"], "default": "GET", "description": "API请求方法" },
      "apiBody": { "type": "object", "description": "POST请求的body数据" },
      "storageKey": { "type": "string", "description": "localStorage/sessionStorage中的数据键名" },
      "expectedData": {
        "type": "array",
        "description": "期望数据，用于与页面数据比对",
        "items": { "type": "object" }
      },
      "baselineName": { "type": "string", "description": "基线名称，用于baseline_compare模式" },
      "extractMode": {
        "type": "string",
        "enum": ["table", "cards", "list", "custom"],
        "description": "数据提取模式：table=表格，cards=卡片列表，list=普通列表，custom=自定义选择器",
        "default": "table"
      },
      "keyFields": {
        "type": "array",
        "description": "主键字段列表，用于数据匹配比对",
        "items": { "type": "string" }
      },
      "ignoreFields": {
        "type": "array",
        "description": "忽略比对的字段列表",
        "items": { "type": "string" }
      },
      "strictMode": { "type": "boolean", "default": false, "description": "严格模式：字段类型和顺序必须完全一致" }
    },
    "required": []
  }
}