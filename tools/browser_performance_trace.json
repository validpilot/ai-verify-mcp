{
  "name": "browser_performance_trace",
  "description": "记录完整的性能轨迹（Paint/Timing/Resource），输出 HAR 格式和结构化性能数据。支持 W3C Performance Timeline API，获取 FP/FCP/LCP/CLS 等核心指标。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "要追踪性能的目标 URL。如果不提供则使用当前页面。"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "navigation",
          "resource",
          "paint",
          "longtask"
        ],
        "description": "要记录的性能类别"
      },
      "duration": {
        "type": "number",
        "default": 5000,
        "description": "追踪持续时间（毫秒）"
      },
      "enableScreenshots": {
        "type": "boolean",
        "default": false,
        "description": "是否在追踪期间定期截图"
      },
      "exportHar": {
        "type": "boolean",
        "default": true,
        "description": "是否导出 HAR 格式数据"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "metrics": {
        "type": "object"
      },
      "grade": {
        "type": "string"
      },
      "recommendations": {
        "type": "array"
      }
    }
  }
}
