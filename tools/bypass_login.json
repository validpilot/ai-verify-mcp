{
  "name": "bypass_login",
  "description": "开源版认证绕过检测：通过多种方式测试是否可以绕过登录验证直接访问受保护页面/API。包括：无 Cookie 请求、修改用户 ID、移除 Authorization 头、测试常见后门路径等。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "targetUrl": {
        "type": "string",
        "description": "目标受保护页面的 URL"
      },
      "authApiPath": {
        "type": "string",
        "description": "认证 API 路径（如 /api/auth/me），用于验证当前登录状态"
      },
      "testCases": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["no_cookie", "no_auth_header", "fake_user_id", "direct_api_access", "backdoor_paths", "idor_test", "unauthorized_access"]
        },
        "default": ["no_cookie", "no_auth_header", "fake_user_id", "direct_api_access", "backdoor_paths"],
        "description": "要执行的测试用例列表"
      },
      "userIdToTest": {
        "type": "string",
        "description": "IDOR 测试时使用的其他用户 ID"
      },
      "backdoorPaths": {
        "type": "array",
        "items": { "type": "string" },
        "description": "自定义后门路径列表，默认使用内置常见路径"
      },
      "maxTestCount": {
        "type": "number",
        "default": 20,
        "description": "最大测试次数"
      }
    },
    "required": ["targetUrl"]
  }
}